@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor "Teaching Assistant" as TA

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
participant ":DeliverablesPanel" as DeliverablesPanel UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:ViewProgressCommand" as ViewProgressCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

TA -> MainWindow : executes "view /id A1234567B"
activate MainWindow
MainWindow -> LogicManager : execute(...)
activate LogicManager
LogicManager -> ViewProgressCommand : execute(m)
activate ViewProgressCommand

ViewProgressCommand -> Model : getAddressBook()
activate Model
Model --> ViewProgressCommand : students
deactivate Model

ViewProgressCommand -> Model : getStudentCourseProgressList()
activate Model
Model --> ViewProgressCommand : progress records
deactivate Model

note right of ViewProgressCommand
  Select the student, then keep every
  progress record with the same student ID.
end note

ViewProgressCommand -> ViewProgressCommand : create view payload and command result
note right of ViewProgressCommand
  The command result contains textual feedback
  and the structured StudentDeliverablesView v.
end note

ViewProgressCommand --> LogicManager : r
deactivate ViewProgressCommand
LogicManager --> MainWindow : r
deactivate LogicManager

MainWindow -> MainWindow : display feedback and focus student card
MainWindow -> DeliverablesPanel : showDeliverables(v)
MainWindow --> TA
deactivate MainWindow
@enduml
