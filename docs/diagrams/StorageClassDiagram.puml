@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "User preferences storage" #F4F6F6 {
Class JsonUserPrefsStorage
}

package "TAssist data storage" #F4F6F6 {
    class JsonAddressBookStorage
    class JsonSerializableAddressBook
    class JsonAdaptedStudent
    class JsonAdaptedCourse
    class JsonAdaptedStudentCourseEnrolment
    class JsonAdaptedStudentCourseProgress
}
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonAddressBookStorage

JsonAddressBookStorage ..> JsonSerializableAddressBook : uses

JsonSerializableAddressBook --> "*" JsonAdaptedStudent
JsonSerializableAddressBook --> "*" JsonAdaptedCourse
JsonSerializableAddressBook --> "*" JsonAdaptedStudentCourseEnrolment
JsonSerializableAddressBook --> "*" JsonAdaptedStudentCourseProgress

JsonAdaptedStudent -[hidden]right- JsonAdaptedCourse
JsonAdaptedCourse -[hidden]right- JsonAdaptedStudentCourseEnrolment
JsonAdaptedStudentCourseEnrolment -[hidden]right- JsonAdaptedStudentCourseProgress
@enduml
