@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR

package "Model" as ModelPackage <<Rectangle>> {
    class "<<interface>>\nModel" as ModelApi
    class ModelManager
    class AddressBook
    class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
    class UserPrefs
    class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs

    class UniqueStudentList
    class UniqueCourseList
    class UniqueStudentCourseEnrolment
    class UniqueStudentCourseProgressList

    class Student
    class Course
    class StudentCourseEnrolment
    class StudentCourseProgress
}

ModelManager .up.|> ModelApi
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs

ModelApi ..> ReadOnlyAddressBook
ModelApi ..> ReadOnlyUserPrefs

ModelManager -down-> "1" AddressBook
ModelManager -right-> "1" UserPrefs

AddressBook *-- "1" UniqueStudentList
AddressBook *-- "1" UniqueCourseList
AddressBook *-- "1" UniqueStudentCourseEnrolment
AddressBook *-- "1" UniqueStudentCourseProgressList

UniqueStudentList --> "*" Student
UniqueCourseList --> "*" Course
UniqueStudentCourseEnrolment --> "*" StudentCourseEnrolment
UniqueStudentCourseProgressList --> "*" StudentCourseProgress

@enduml
