@startuml
!include style.puml
show fields
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor white
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR

package "Model" as ModelPackage <<Rectangle>> {
    class "<<interface>>\nModel" as ModelApi
    class ModelManager
    class AddressBook

    class Student {
        Id
        Name
        Email
    }

    class Course {
        CourseCode courseCode
        Deliverable deliverable
        Semester semester
        List<Deliverable> deliverables
    }

    class StudentCourseEnrolment {
        studentId: Id
        CourseCode
        Semester
        TutorialClass
        NotesList
    }

    class StudentCourseProgress
}

ModelManager .up.|> ModelApi
ModelManager -down-> "1" AddressBook : manages

AddressBook *-- "*" Student : stores
AddressBook *-- "*" Course : stores
AddressBook *-- "*" StudentCourseEnrolment : stores
AddressBook *-- "*" StudentCourseProgress : stores

Student "*" -- "*" Course : enrolled in
(Student, Course) .. StudentCourseEnrolment

@enduml
