@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR

package "Model" as ModelPackage <<Rectangle>> {
    class "<<interface>>\nModel" as ModelApi
    class ModelManager
    class AddressBook

    class Student
    class Course
    class StudentCourseEnrolment
    class StudentCourseProgress
}

ModelManager .up.|> ModelApi
ModelManager -down-> "1" AddressBook : manages

AddressBook *-- "*" Student : stores
AddressBook *-- "*" Course : stores
AddressBook *-- "*" StudentCourseEnrolment : stores
AddressBook *-- "*" StudentCourseProgress : stores

@enduml
