<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="true" title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <BorderPane fx:id="helpMessageContainer">
        <center>
          <TextArea fx:id="helpMessage" editable="false" focusTraversable="false" prefHeight="700.0"
                    prefWidth="950.0" wrapText="false" />
        </center>
        <bottom>
          <HBox alignment="CENTER_RIGHT">
            <children>
              <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy User Guide URL" />
            </children>
            <padding>
              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
          </HBox>
        </bottom>
        <padding>
          <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
      </BorderPane>
    </Scene>
  </scene>
</fx:root>
