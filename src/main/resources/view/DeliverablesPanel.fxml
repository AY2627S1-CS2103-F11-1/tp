<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="deliverables-panel">
  <padding>
    <Insets top="16" right="16" bottom="16" left="16" />
  </padding>

  <Label fx:id="emptyState" text="Use view to display a student's deliverables or notes."
         wrapText="true" styleClass="deliverables-empty-state" />

  <VBox fx:id="content" spacing="4">
    <Label fx:id="studentName" wrapText="true" styleClass="deliverables-student-name" />
    <HBox spacing="8" alignment="CENTER_LEFT"  styleClass="deliverables-student-id">
        <ImageView fitWidth="16"
                    fitHeight="16"
                    preserveRatio="true">
            <image>
                <Image url="@../images/id-card.png" />
            </image>
        </ImageView>
        <Label fx:id="studentId"
                styleClass="cell_small_label" />
    </HBox>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="deliverables-scroll-pane">
      <content>
        <VBox fx:id="courses" spacing="8" />
      </content>
    </ScrollPane>
  </VBox>
</StackPane>
